# Server only. Copy to .env on the backend host; never put real secrets in Git.
APP_ENV=development
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Recommended production database. Run migration_v8_security.sql first.
# Supabase transaction-pooler or direct PostgreSQL connection URI, TLS required in production.
DATABASE_URL=
# Development fallback; production SQLite requires a durable disk and explicit opt-in.
FMV_DB_PATH=./data/firstmilk.sqlite3
ALLOW_PRODUCTION_SQLITE=false
RESEND_API_KEY=
AUTH_EMAIL_SENDER=First Milk Venture Auth <auth@firstmilkventure.com>
ALLOWED_ORIGINS=https://firstmilkventure.com,https://www.firstmilkventure.com,https://admin.firstmilkventure.com,https://delivery.firstmilkventure.com,http://localhost:8000,http://127.0.0.1:8000
# Optional: keep blank until merchant setup is complete.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional CA certificate path for verify-full PostgreSQL TLS verification.
PGSSLROOTCERT=
# Retained legacy settings; v8 canonical transactions use DATABASE_URL, not PostgREST.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# v9 order and invitation emails use this verified sender (fallback: AUTH_EMAIL_SENDER).
ORDER_EMAIL_SENDER=First Milk Venture <auth@firstmilkventure.com>
