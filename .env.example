# Server only. Copy to .env on the backend host; never put real secrets in Git.
APP_ENV=development
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Recommended production database. Run migration_v8_security.sql first.
# Supabase transaction-pooler or direct PostgreSQL connection URI, TLS required in production.
DATABASE_URL=
# Development fallback; production SQLite requires a durable disk and explicit opt-in.
FMV_DB_PATH=./data/firstmilk.sqlite3
ALLOW_PRODUCTION_SQLITE=false
RESEND_API_KEY=
AUTH_EMAIL_SENDER=First Milk Venture Auth <auth@firstmilkventure.com>
ALLOWED_ORIGINS=https://firstmilkventure.com,https://www.firstmilkventure.com,https://admin.firstmilkventure.com,https://delivery.firstmilkventure.com,http://localhost:8000,http://127.0.0.1:8000
# Optional: keep blank until merchant setup is complete.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional CA certificate path for verify-full PostgreSQL TLS verification.
PGSSLROOTCERT=
# Retained legacy settings; v8 canonical transactions use DATABASE_URL, not PostgREST.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Department-specific sender addresses on your verified company domain.
ORDER_EMAIL_SENDER=First Milk Orders <orders@firstmilkventure.com>
DELIVERY_EMAIL_SENDER=First Milk Delivery <delivery@firstmilkventure.com>
DRIVER_EMAIL_SENDER=First Milk Drivers <drivers@firstmilkventure.com>
ADMIN_EMAIL_SENDER=First Milk Administration <admin@firstmilkventure.com>
FINANCE_EMAIL_SENDER=First Milk Accounts <accounts@firstmilkventure.com>
SUPPORT_EMAIL_SENDER=First Milk Support <support@firstmilkventure.com>
MARKETING_EMAIL_SENDER=First Milk Offers <offers@firstmilkventure.com>
SECURITY_EMAIL_SENDER=First Milk Security <security@firstmilkventure.com>

# Optional first-admin invitation for hosting plans without a terminal.
# Set privately in the hosting dashboard, then remove after verified signup.
# Choose a private random code of 32–200 characters without spaces.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_INVITATION=
